{
    "appId": "com.safetywatch.app",
    "appName": "SafetyWatch",
    "webDir": "dist",
    "server": {
        "androidScheme": "https",
        "url": "https://safetywatch.vercel.app",
        "cleartext": true
    },
    "plugins": {
        "StatusBar": {
            "style": "DARK",
            "backgroundColor": "#05070a",
            "overlaysWebView": true
        },
        "SplashScreen": {
            "launchShowDuration": 0,
            "launchAutoHide": true,
            "backgroundColor": "#020817",
            "androidSplashResourceName": "splash",
            "showSpinner": false
        },
        "PushNotifications": {
            "presentationOptions": [
                "badge",
                "sound",
                "alert"
            ]
        },
        "CapacitorHttp": {
            "enabled": true
        },
        "GoogleAuth": {
            "scopes": ["profile", "email"],
            "serverClientId": "419789227892-3ftv7o8j3c4lbabpnjlm66fcf1pbu1h7.apps.googleusercontent.com",
            "androidClientId": "419789227892-n2li9n170g9g4ictn0lit16nv7nv1kdp.apps.googleusercontent.com",
            "forceCodeForRefreshToken": true
        }
    }
}